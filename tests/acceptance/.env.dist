APP_URL=<your-local-shop-url>

# Choose one authentication method.

# Authentication via admin user
SHOPWARE_ADMIN_USERNAME=<your-admin-username>
SHOPWARE_ADMIN_PASSWORD=<your-admin-password>

# Or authentication via integration
# SHOPWARE_ACCESS_KEY_ID=<your-integration-access-key>
# SHOPWARE_SECRET_ACCESS_KEY=<your-integration-secret-key>
